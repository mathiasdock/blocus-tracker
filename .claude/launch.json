{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blocus-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "blocus-offline",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 4321,
      "autoPort": true
    },
    {
      "name": "blocus-offline-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_PUBLIC_OFFLINE_DEV=true", "npx", "next", "dev", "-p", "4340"],
      "port": 4340,
      "autoPort": false
    }
  ]
}
